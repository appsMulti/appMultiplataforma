<!DOCTYPE html>
<html lang="es">
<head>
  <title>Consultar información de la escuela</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- DataTables -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

  <style>
    body { margin: 0; padding: 0; }

    /* ── LANDING ── */
    #vista-landing {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: #f8f9fa;
    }

    .header-logos {
      display: flex;
      align-items: center;
      margin-bottom: 1rem;
      padding: 1rem 1.5rem 0;
    }

    .nav-links {
      display: flex;
      align-items: center;
      margin-bottom: 1.5rem;
      padding: 0 1.5rem;
      gap: 1.5rem;
    }
    .nav-links .fw-bold { margin-right: auto; }

    .hero-landing {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 3rem 1.5rem;
    }

    .hero-landing h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #003366;
      margin-bottom: 1rem;
    }

    .hero-landing p {
      max-width: 550px;
      color: #555;
      margin-bottom: 2rem;
    }

    .logos-tech {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      padding: 2rem 1.5rem;
      border-top: 1px solid #dee2e6;
      margin-top: 2rem;
    }

    /* ── TABLAS ── */
    #vista-tablas { display: none; padding: 1rem 1.5rem; }
  </style>
</head>
<body>

  <!-- ══ VISTA: LANDING (tu index2.html original, intacto) ══ -->
  <div id="vista-landing">

    <!-- Logos -->
    <div class="header-logos">
      <img src="unam.png" height="80" class="rounded" alt="UNAM">
      <div class="ms-auto">
        <img src="fca.png" height="80" class="rounded" alt="FCA">
      </div>
    </div>

    <!-- Menú -->
    <div class="nav-links">
      <div class="fw-bold">Menú</div>
      <a href="#" class="text-decoration-none text-primary">Inicio</a>
      <a href="#" class="text-decoration-none text-primary">Directorio</a>
      <a href="#" class="text-decoration-none text-primary">Contacto</a>
      <a href="#" class="text-decoration-none text-primary"
         onclick="mostrarTablas(); return false;">Tablas de datos</a>
    </div>

    <!-- Hero -->
    <div class="hero-landing">
      <h1>Bienvenido al Portal Escolar</h1>
      <p>Accede a la información académica:</p>
      <button class="btn btn-primary px-4 py-2"
              onclick="mostrarTablas()">Ver Tablas de datos</button>
    </div>

  </div>

  <!-- ══ VISTA: TABLAS (tu index.ejs original, intacto) ══ -->
  <div id="vista-tablas">

    <h2>Tablas de datos</h2>

    <button class="btn btn-outline-secondary btn-sm mb-3"
            onclick="mostrarLanding()">← Volver al inicio</button>

    <br>

    <button id="btnAlumnos"     class="btn btn-primary">Alumnos</button>
    <button id="btnProfesores"  class="btn btn-primary">Profesores</button>
    <button id="btnEntidades"   class="btn btn-primary">Entidades</button>
    <button id="btnAsignaturas" class="btn btn-primary">Asignaturas</button>
    <button id="btnPlanteles"   class="btn btn-primary">Planteles</button>

    <br><br>

    <table id="mainTable" class="display" style="width:100%">
      <thead>
        <tr id="tableHead"></tr>
      </thead>
    </table>

  </div>

  <!-- Tu main.js original, sin ningún cambio -->
  <script src="/js/main.js"></script>

  <script>
    var primeraVez = true;

    function mostrarTablas() {
      document.getElementById('vista-landing').style.display = 'none';
      document.getElementById('vista-tablas').style.display  = 'block';

      // Se llama loadAlumnos() solo la primera vez que se entra,
      // porque DataTables necesita que el div sea visible para renderizar bien.
      if (primeraVez) {
        primeraVez = false;
        loadAlumnos();
      }
    }

    function mostrarLanding() {
      document.getElementById('vista-tablas').style.display  = 'none';
      document.getElementById('vista-landing').style.display = 'flex';
    }
  </script>

</body>
</html>