<!DOCTYPE html>
<html lang="es">
<head>
  <title>Consultar información de la escuela</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

  <!-- Header permanente -->
  <header id="site-header">
    <div class="logos">
      <img src="unam.png" height="60" class="rounded" alt="UNAM">
      <img src="fca.png"  height="60" class="rounded" alt="FCA">
    </div>
    <nav>
      <a id="navInicio" href="#">Inicio</a>
      <a href="#">Directorio</a>
      <a href="#">Contacto</a>
      <a id="navTablas" href="#">Tablas de datos</a>
    </nav>
  </header>

  <!-- Vista landing -->
  <div id="vista-landing">
    <h1>Bienvenido al Portal Escolar</h1>
    <p>Accede a la información académica:</p>
    <button id="btnVerTablas" class="btn btn-primary px-4 py-2">Ver Tablas de datos</button>
  </div>
  

  <!-- Vista tablas -->
  <div id="vista-tablas">

    <h4 class="mb-3 fw-bold" style="color:#003366;">Tablas de datos</h4>

    <div class="btn-tabla-group">
      <button id="btnAlumnos" class="btn btn-outline-primary">Alumnos</button>
      <button id="btnProfesores" class="btn btn-outline-primary">Profesores</button>
      <button id="btnEntidades" class="btn btn-outline-primary">Entidades</button>
      <button id="btnAsignaturas" class="btn btn-outline-primary">Asignaturas</button>
      <button id="btnPlanteles" class="btn btn-outline-primary">Planteles</button>

    </div>

    <div id="tabla-wrapper">
      <div class="tabla-card">
        <div class="tabla-header">
          <h5 id="tabla-titulo">Alumnos</h5>
          <button id="btnAgregarNuevo" class="btn btn-success btn-sm" >+ Agregar</button>
        </div>
        <table id="mainTable" class="table table-bordered table-hover">
          <thead>
            <tr id="tableHead"></tr>
          </thead>
        </table>
      </div>
    </div>

  </div>

  <!-- Modal dinámico (el JS llena el body según la tabla activa) -->
  <div class="modal fade" id="viewModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title" id="modalTitulo">Información</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body" id="modalBody">
          
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
          <button type="button" id="btnUpdate" class="btn btn-primary">Actualizar</button>
        </div>

      </div>
    </div>
  </div>

  <!--Modal para agregar un nuevo registro-->
  <div class="modal fade" id="nuevoModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title" id="modalTituloNuevo"> Agregar</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body" id="modalBodyNuevo">
        </div>

        <div class="modal-footer">

          <button 
            type="button" 
            class="btn btn-secondary"
            data-bs-dismiss="modal">
            Cancelar
          </button>

          <button 
            type="button"
            id="btnGuardarNuevo"  
            class="btn btn-success">
            Guardar
          </button>

        </div>

      </div>
    </div>
  </div>

  <!--al ser moodule se puede usar import y export en los js-->
  <!--los scripts dentro de js serán indepentiendes-->
  <script type="module" src="/js/main.js"></script>
</body>
</html>